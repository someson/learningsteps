# Database admin credentials for the local docker compose stack: read by the
# postgres and migrate services only, never by the API. Copy to .env.db
# (git-ignored):
#   cp app/.env.db-sample app/.env.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learning_journal

ADMIN_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/learning_journal
