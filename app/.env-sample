# API settings for the local docker compose stack. Copy to .env (git-ignored):
#   cp app/.env-sample app/.env
# Database admin credentials live separately in .env.db (see .env.db-sample),
# so the API container never receives them.

# The API connects as a dedicated, unprivileged role. The `migrate` service
# creates it with this password and grants it row access only.
DATABASE_URL=postgresql://learningsteps:learningsteps-local@postgres:5432/learning_journal

# Local stack is plain HTTP: Secure cookies would never be sent back.
# Leave unset (true) anywhere behind HTTPS.
COOKIE_SECURE=false

# Swagger UI at /docs. Off unless set; AKS leaves it off.
ENABLE_DOCS=true

# Session lifetime (default 12).
# SESSION_TTL_HOURS=12
